{
  "rules": [
    {
      "action": "block",
      "description": "Batasi kiriman form kontak per IP",
      "expression": "(http.request.uri.path eq \"/api/contact\" and http.request.method eq \"POST\")",
      "ratelimit": {
        "characteristics": ["ip.src", "cf.colo.id"],
        "period": 10,
        "requests_per_period": 5,
        "mitigation_timeout": 10
      }
    }
  ]
}
